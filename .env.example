# Kopieren nach .env.local (lokal) bzw. in Vercel unter Settings → Environment Variables eintragen.

# Neon: Connection string (Dashboard → Connect → «Pooled connection»)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Resend: API-Key (resend.com → API Keys)
RESEND_API_KEY="re_xxxxxxxx"

# Zufälliger, langer Schlüssel für die Admin-Anmeldung (siehe README)
SESSION_SECRET="bitte-einen-langen-zufaelligen-wert-eintragen"

# Öffentliche Adresse der Webseite
SITE_URL="https://dersut.ch"

# Optional: Vercel Blob für Produktbilder-Upload im Admin (Vercel → Storage → Blob)
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"
